# Local example only. These values are placeholders, not production credentials.
# Use without creating .env: docker compose --env-file .env.example up --build -d --wait
# Then apply migrations manually: docker compose --env-file .env.example exec backend alembic upgrade head
POSTGRES_DB=civicpulse
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=replace-me
# Keep this URL in sync with POSTGRES_*; URL-encode special characters in credentials.
DATABASE_URL=postgresql+psycopg://civicpulse:replace-me@postgres:5432/civicpulse
REDIS_URL=redis://redis:6379/0
TRIAGE_PROVIDER=simulated
RATE_LIMIT_PER_MIN=10
GROQ_API_KEY=
GEMINI_API_KEY=

# Production uses existing images. Set repositories and their shared commit SHA tag.
# Use compose.prod.yaml on its own, not as an override of compose.yaml.
FRONTEND_IMAGE=civicpulse-frontend
BACKEND_IMAGE=civicpulse-backend
IMAGE_TAG=replace-with-commit-sha
